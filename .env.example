# Codex integration settings
# Set this to the directory where Codex stores prompts/skills so CLI scripts can discover them.
CODEX_HOME=${HOME}/.codex

# Runtime environment
# Switch between development and production builds (used by scripts/tools if needed).
NODE_ENV=development

# API keys / secrets (replace with your own values before running).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# Additional provider tokens can be listed here as needed.
